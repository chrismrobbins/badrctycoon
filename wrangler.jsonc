{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "badrctycoon",
  "main": "server/src/worker.ts",
  "compatibility_date": "2026-08-08",
  // pg's Postgres driver needs Node's net/tls/events/etc., which nodejs_compat
  // shims. Hyperdrive is what makes the TCP connection itself work from a
  // Workers isolate.
  "compatibility_flags": ["nodejs_compat"],

  // Client build (vite.config.ts outDir: '../dist') served straight off the
  // edge; /api/* always reaches the Worker even though nothing under it would
  // ever collide with a real asset path -- being explicit here is cheap
  // insurance against that changing later.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b7139c82272c4e25b229b92d345648aa"
    }
  ],

  // General IP backstop on auth endpoints (server/src/routes/auth.ts). The
  // built-in binding's period is fixed to 10 or 60 seconds -- fine for this,
  // not fine for the per-username windows below, which need to survive much
  // longer than a minute. See auth/rateLimit.ts.
  "ratelimits": [
    {
      "name": "RL_AUTH_IP",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  // Per-username login/register throttling (5 attempts / 15-60 min) needs a
  // window longer than the rate-limit binding allows, so it's a KV counter
  // with expirationTtl instead -- see auth/rateLimit.ts for the eventual-
  // consistency tradeoff that comes with that.
  "kv_namespaces": [
    {
      "binding": "AUTH_ATTEMPTS",
      "id": "1ed6a59a5b7d4ae99da69632357d2b67"
    }
  ],

  // save_history pruning (jobs/pruneHistory.ts) -- was a setInterval in the
  // Node build; Workers don't stay alive between requests, so this is what
  // "on a schedule, not in a trigger" (API-CONTRACT.md §5) becomes here.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}

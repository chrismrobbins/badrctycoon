    "url": "https://github.com/chrismrobbins/badrctycoon/issues"
  },
  "homepage": "https://github.com/chrismrobbins/badrctycoon#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "private": true,
  "dependencies": {
    "@fastify/cookie": "^11.1.2",

{
  "name": "badrctycoon",
  "version": "1.0.0",
  "description": "Isometric theme-park management game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "server:dev": "tsx watch server/src/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrismrobbins/badrctycoon.git"
  },

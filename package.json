{
  "name": "badrctycoon",
  "version": "1.0.0",
  "description": "Isometric theme-park management game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "node scripts/check-sim-boundary.mjs",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrismrobbins/badrctycoon.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/chrismrobbins/badrctycoon/issues"
  },
  "homepage": "https://github.com/chrismrobbins/badrctycoon#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "private": true,
  "dependencies": {
    "argon2-wasm-edge": "^1.0.23",
    "hono": "^4.13.1",
    "pg": "^8.22.0"
  }
}
